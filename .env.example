# Supabase project credentials (from supabase.com dashboard → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Trafikverket API key — register free at https://api.trafikinfo.trafikverket.se/
TRAFIKVERKET_API_KEY=

# Firebase service account JSON (for push notifications from Edge Functions)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
